BACKEND_API_URL=http://localhost:5000/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_WS_URL=ws://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_CONTRACT_ID=CB5XMDHT66EISB4WXM4YGNDHYRMZDX42TOHZEAENIUTSSMRFHJSFRNHB
# Required for mobile Freighter connections through WalletConnect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
STRICT_ENV_VALIDATION=false

# Dev mode auth bypass: skips real backend auth checks
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# Mock user role when auth bypass is enabled (user or admin)
NEXT_PUBLIC_DEV_MOCK_ROLE=user

# Local draft recovery for the multi-step account settings flow.
# Set to false to disable storing unsaved settings input in localStorage.
NEXT_PUBLIC_SETTINGS_RECOVERY_ENABLED=true
